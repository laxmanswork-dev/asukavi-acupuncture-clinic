# Google Maps JavaScript API key (restrict by HTTP referrer to your domain
# in Google Cloud Console). Requires "Maps JavaScript API" + "Places API" enabled.
VITE_GOOGLE_MAPS_API_KEY=

# Place ID for Asukavi Acupuncture Clinic (find via
# https://developers.google.com/maps/documentation/places/web-service/place-id)
VITE_GOOGLE_PLACE_ID=
